  m_text: "\u0422\u0435\u0440\u043C\u043E\u0441\u0444\u0435\u0440\u0430 \u2014 \u044D\u0442\u043E
    \u0441\u043B\u043E\u0439 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u044B,
